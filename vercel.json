{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "outputDirectory": "apps/api/dist"
  {
  "rewrites": [{ "source": "/api/(.*)", "destination": "src/main.ts" }]
}
}